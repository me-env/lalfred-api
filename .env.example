# Database
DATABASE_URL=postgresql+asyncpg://lalfred:lalfred_dev@localhost:5432/lalfred

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Lemon Squeezy
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMONSQUEEZY_API_KEY=your-api-key

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# OpenTelemetry
OTEL_SERVICE_NAME=lalfred-api-dev
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://s2411025.eu-fsn-3.betterstackdata.com
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-better-stack-source-token
